<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:background="@color/activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_inner_vertical"
                        android:layout_marginBottom="@dimen/card_inner_vertical"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="@dimen/card_inner_horizontal">
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkUTF"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/utf_8_to_ascii"/>
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkDontAsk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/don_t_asking_url"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="@dimen/card_inner_vertical"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="@dimen/card_inner_horizontal">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/printing_copies"
                            android:drawablePadding="8dp"
                            app:drawableStartCompat="@drawable/ic_print_black_18dp"
                            app:drawableTint="@color/color_important"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <SeekBar
                            android:id="@+id/seekCopies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="5"
                            android:progress="1"
                            style="@style/Widget.AppCompat.SeekBar.Discrete"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/_1_min"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/max_5"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="@dimen/card_inner_vertical"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="@dimen/card_inner_horizontal">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/truncation_rules"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="@dimen/card_inner_horizontal"
                            app:drawableStartCompat="@drawable/ic_picture_as_pdf_black_24dp"
                            app:drawableTint="@color/color_important"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkTruncateMozila"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/remove_header_and_footer"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/height"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkRoll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/roll"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/width"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/spinnerWidthTruncate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_inner_vertical"
                            android:layout_marginBottom="@dimen/card_inner_vertical"
                            android:spinnerMode="dialog"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/other"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkTruncateTopOnFirst"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/cut_on_the_first_page_from_the_top"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/pnlTopCut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_inner_vertical"
                            android:layout_marginBottom="@dimen/card_inner_vertical"
                            android:baselineAligned="false">
                            <com.google.android.material.textfield.TextInputLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="@string/top_crop_count"
                                android:layout_weight="3">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTopCrop"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:inputType="number"
                                    android:importantForAutofill="no"/>
                            </com.google.android.material.textfield.TextInputLayout>
                            <TextView
                                android:textColor="@color/white"
                                android:id="@+id/saveTopCrop"
                                android:background="@color/colorPrimary"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/btnLanSave_desc"/>
                        </LinearLayout>
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkTruncateFrame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/crop_the_frame_around"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/pnlTruncateFrame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_inner_vertical"
                            android:layout_marginBottom="@dimen/card_inner_vertical"
                            android:baselineAligned="false">
                            <com.google.android.material.textfield.TextInputLayout
                                android:orientation="horizontal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="@string/top_crop_count"
                                android:layout_weight="3">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTruncateFrame"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:inputType="number"
                                    android:importantForAutofill="no"/>
                            </com.google.android.material.textfield.TextInputLayout>
                            <TextView
                                android:textColor="@color/white"
                                android:id="@+id/saveTruncateFrame"
                                android:background="@color/colorPrimary"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/btnLanSave_desc"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/cut_between_pages"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"
                            app:drawableStartCompat="@drawable/ic_baseline_content_cut_24"
                            app:drawableTint="@color/color_important"/>
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkCutBetween"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:checkMark="?android:attr/listChoiceIndicatorMultiple"
                            android:text="@string/when_printing_pdf_or_print_job"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="@dimen/card_inner_vertical"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="@dimen/card_inner_horizontal">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/how_print_images"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="@dimen/card_inner_horizontal"
                            app:drawableStartCompat="@drawable/ic_gradient_black_24dp"
                            app:drawableTint="@color/color_important"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <Spinner
                            android:id="@+id/spinnerGraph"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_inner_vertical"
                            android:layout_marginBottom="@dimen/card_inner_vertical"
                            android:spinnerMode="dialog"/>
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/colorAccent"
                            android:id="@+id/youtubeFilters"
                            android:background="@drawable/bean_nav"
                            android:padding="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/videofilters"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="0dp"
                            app:drawableStartCompat="@drawable/ic_youtube"
                            app:drawableTint="@color/colorAccent"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.cardview.widget.CardView
                    android:id="@+id/fontInternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:text="@string/internal_printer_font_settings"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="0dp"
                            android:text="@string/font_size"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/spinnerFontSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:spinnerMode="dialog"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="0dp"
                            android:text="@string/cpi"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/spinnerCPI"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:spinnerMode="dialog"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="0dp"
                            android:text="@string/special_chars"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/spinnerEscR"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:spinnerMode="dialog"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:text="@string/font_size_for_truetype"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <TextView
                            android:id="@+id/textGraphFontSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"/>
                        <SeekBar
                            android:id="@+id/seekBarFont"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/print_job_limits"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_inner_horizontal"
                            android:layout_marginEnd="@dimen/card_inner_horizontal"
                            app:drawableStartCompat="@drawable/ic_print_black_18dp"
                            app:drawableTint="@color/color_important"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/max_pages_count"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/limitPages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:spinnerMode="dialog"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/max_files_count"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/limitFiles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:spinnerMode="dialog"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/maximum_file_size_for_text_printing"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/limitFileSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:spinnerMode="dialog"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="64dp"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_important"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/download_limits"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_inner_horizontal"
                            android:layout_marginEnd="@dimen/card_inner_horizontal"
                            app:drawableStartCompat="@drawable/ic_wifi_black_24dp"
                            app:drawableTint="@color/color_important"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:text="@string/max_download_size"
                            android:drawablePadding="8dp"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                        <Spinner
                            android:id="@+id/limitDownload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="@dimen/card_margin_vertical"
                            android:spinnerMode="dialog"
                            android:layout_marginStart="@dimen/card_margin_horizontal"
                            android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
