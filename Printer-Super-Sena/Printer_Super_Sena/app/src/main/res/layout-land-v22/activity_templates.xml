<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:background="@color/activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/doc_head"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="@dimen/card_inner_horizontal"
                    android:layout_marginEnd="@dimen/card_inner_horizontal"
                    app:drawableStartCompat="@drawable/ic_baseline_receipt_long_24"
                    app:drawableTint="@color/color_important"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkPrintLogo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_inner_vertical"
                            android:checked="true"
                            android:checkMark="?android:attr/listChoiceIndicatorMultiple"
                            android:text="@string/print_logo"
                            android:layout_marginStart="8dp"/>
                        <ImageView
                            android:id="@+id/check_logo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/card_margin_vertical"
                            android:contentDescription="@string/check_logo_preview"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/notPremiumBlock"
                            android:padding="@dimen/card_margin_horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="@dimen/card_margin_vertical">
                            <TextView
                                android:id="@+id/tvWhyNoSelectLogo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/aboutCheckLogo"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textColor="@color/white"
                                android:id="@+id/btnOpenLic"
                                android:background="@drawable/bean_btn_blue"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buy_premium"
                                android:layout_marginEnd="8dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvWhyNoSelectLogo"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/premiumBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_margin_vertical"
                            android:layout_marginBottom="24dp">
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                android:id="@+id/btnDeleteLogo"
                                android:background="@drawable/border_1_kbd"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dialog_cancel"
                                android:layout_marginStart="@dimen/card_inner_horizontal"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textColor="@color/white"
                                android:id="@+id/btnSelectLogo"
                                android:background="@drawable/bean_btn_blue"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reSelectTxt"
                                android:layout_marginEnd="8dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_inner_vertical"
                        android:layout_marginBottom="@dimen/card_inner_vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            android:background="@color/background_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/input_editor">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textSize="18sp"
                                android:id="@+id/text_top"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@color/white"
                                android:id="@+id/saveTopText"
                                android:background="@drawable/bean_btn_blue"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btnLanSave_desc"
                                android:layout_marginEnd="8dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/doc_bottom"
                    android:drawablePadding="8dp"
                    android:layout_marginStart="@dimen/card_inner_horizontal"
                    android:layout_marginEnd="@dimen/card_inner_horizontal"
                    app:drawableStartCompat="@drawable/ic_baseline_receipt_long_24"
                    app:drawableTint="@color/color_important"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_inner_vertical"
                        android:layout_marginBottom="@dimen/card_inner_vertical">
                        <com.google.android.material.textfield.TextInputLayout
                            android:background="@color/background_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/input_editor">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textSize="18sp"
                                android:id="@+id/text_bottom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@color/white"
                                android:id="@+id/saveBottomText"
                                android:background="@drawable/bean_btn_blue"
                                android:padding="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btnLanSave_desc"
                                android:layout_marginEnd="8dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/card_inner_vertical">
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkPrintDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"
                            android:checked="true"
                            android:checkMark="?android:attr/listChoiceIndicatorMultiple"
                            android:text="@string/printDateTime"
                            android:layout_marginStart="8dp"/>
                        <CheckBox
                            android:textSize="16sp"
                            android:id="@+id/chkPaperCut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"
                            android:checked="true"
                            android:checkMark="?android:attr/listChoiceIndicatorMultiple"
                            android:text="@string/cut_command"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="64dp"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/textDemoPrint"
                        android:background="@drawable/bean_btn_blue"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btnTest"
                        android:drawablePadding="8dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="32dp"
                        app:drawableStartCompat="@drawable/ic_local_printshop_white_18dp"
                        app:drawableTint="@color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
