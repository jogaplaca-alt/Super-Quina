<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet"
    android:tag="layout/fragment_editor_bottom_0"
    android:background="@color/darker_gray"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    app:behavior_hideable="false"
    app:behavior_peekHeight="50dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnEditSelect"
            android:background="@drawable/bean_btn_blue_dark"
            android:focusable="true"
            android:nextFocusUp="@+id/input_area"
            android:nextFocusDown="@+id/rbAlignLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reSelectTxt"
            android:layout_weight="1"
            android:nextFocusForward="@+id/btnEditPrint"
            style="@style/Widget.AppCompat.Button.Colored"/>
        <Button
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnEditPrint"
            android:background="@drawable/bean_btn_blue"
            android:focusable="true"
            android:nextFocusUp="@+id/input_area"
            android:nextFocusDown="@+id/rbAlignLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTxtPrint"
            android:layout_weight="1"
            android:nextFocusForward="@+id/rbAlignLeft"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/imageViewBottomSwipe"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/navigation_drawer_open"
        app:layout_constraintBottom_toBottomOf="@+id/bottomBtn"
        app:srcCompat="@drawable/up"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:layout_constraintTop_toBottomOf="@+id/imageViewBottomSwipe">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/card_inner_vertical">
            <RadioGroup
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RadioButton
                    android:id="@+id/rbAlignLeft"
                    android:tag="binding_1"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/btnEditPrint"
                    android:nextFocusUp="@+id/btnEditSelect"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_align_left_24"
                    android:drawableTint="@color/screen_white"/>
                <RadioButton
                    android:id="@+id/rbAlignCenter"
                    android:tag="binding_2"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btnEditSelect"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_align_center_24"
                    android:drawableTint="@color/screen_white"/>
                <RadioButton
                    android:id="@+id/rbAlignRight"
                    android:tag="binding_3"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btnEditSelect"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_align_right_24"
                    android:drawableTint="@color/screen_white"/>
            </RadioGroup>
            <Spinner
                android:layout_gravity="end"
                android:id="@+id/spinnerFontType"
                android:nextFocusRight="@+id/chkW2"
                android:nextFocusUp="@+id/btnEditPrint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:nextFocusForward="@+id/chkW2"
                android:textAlignment="textEnd"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">
            <CheckBox
                android:textColor="@color/screen_white"
                android:id="@+id/chkW2"
                android:tag="binding_4"
                android:nextFocusLeft="@+id/spinnerFontType"
                android:nextFocusUp="@+id/rbAlignLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wx2"/>
            <CheckBox
                android:textColor="@color/screen_white"
                android:tag="binding_5"
                android:nextFocusUp="@+id/rbAlignCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hx2"/>
            <CheckBox
                android:tag="binding_6"
                android:nextFocusUp="@+id/rbAlignRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_bold_24"
                android:drawableTint="@color/screen_white"/>
            <CheckBox
                android:tag="binding_7"
                android:nextFocusUp="@+id/rbAlignRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_underlined_24"
                android:drawableTint="@color/screen_white"/>
        </LinearLayout>
        <TextView
            android:id="@+id/textGraphFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <SeekBar
            android:id="@+id/seekBarFont"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginBottom="24dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/background_color"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true">
            <TextView
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/printer"
                android:layout_marginEnd="16dp"/>
            <Spinner
                android:id="@+id/spinnerSelectPrinter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/background_color"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:gravity="start"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/template"/>
                <Spinner
                    android:id="@+id/spinnerSelectTemplate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copies"/>
                <Spinner
                    android:id="@+id/spinnerNumbersCopies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
