<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:background="@color/activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:id="@+id/titleGraphicCommand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="8dp"
                android:text="@string/command_for_print_image"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@drawable/ic_gradient_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="32dp"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/card_margin_vertical">
                    <TextView
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/if_garbage_instead_circle"/>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/photo_wrong_gsv0_new"
                        android:adjustViewBounds="true"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/faq_err_garbage_wrong_command"/>
                    <Spinner
                        android:id="@+id/spinnerDriver"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:spinnerMode="dialog"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal">
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/graphDemoPrint"
                            android:background="@color/colorPrimary"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btnTest"
                            android:drawablePadding="8dp"
                            android:paddingStart="24dp"
                            android:paddingEnd="32dp"
                            app:drawableStartCompat="@drawable/ic_local_printshop_white_18dp"
                            app:drawableTint="@color/white"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:id="@+id/titleLang1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:text="@string/panel_local_title"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                app:drawableStartCompat="@drawable/ic_language_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLang1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/card_margin_vertical">
                    <RadioButton
                        android:id="@+id/cpType0"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_type_0"/>
                    <RadioButton
                        android:id="@+id/cpType3"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_type_3"/>
                    <RadioButton
                        android:id="@+id/cpType10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_type_10"/>
                    <RadioButton
                        android:id="@+id/cpType1"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cp_type_1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:text="@string/txt_lng_utf"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <RadioButton
                        android:id="@+id/cpType5"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_utf_default"/>
                    <RadioButton
                        android:id="@+id/cpType6"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_utf_epson"/>
                    <RadioButton
                        android:id="@+id/cpType7"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_utf_star"/>
                    <RadioButton
                        android:id="@+id/cpType8"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_utf_citizen"/>
                    <RadioButton
                        android:id="@+id/cpType9"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_utf_pt210"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/textDemoPrintSimple"
                        android:background="@color/colorPrimary"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/short_text"
                        android:drawablePadding="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="8dp"
                        app:drawableStartCompat="@drawable/ic_local_printshop_white_18dp"
                        app:drawableTint="@color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:text="@string/cut_command"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                app:drawableStartCompat="@drawable/ic_baseline_content_cut_24"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:text="@string/skip_lines"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <Spinner
                        android:id="@+id/spinnerLines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:spinnerMode="dialog"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/color_important"
                        android:id="@+id/titleCutCommand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:text="@string/cut_command"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <Spinner
                        android:id="@+id/spinnerCut"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:spinnerMode="dialog"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                layout="@layout/fs_flow_control"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:id="@+id/titleLang2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:text="@string/for_expert"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                app:drawableStartCompat="@drawable/ic_settings_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLang2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:text="@string/cp_type_2"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <Spinner
                        android:id="@+id/spinnerCP"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:spinnerMode="dialog"/>
                    <RadioButton
                        android:id="@+id/cpType2"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_type_04"/>
                    <RadioButton
                        android:id="@+id/cpType4"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/cp_type_4"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:text="@string/you_may_add_esc_commands"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/after_default_init_print_job"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editBytesInit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:importantForAutofill="no"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/at_the_end_of_a_print_job"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editBytesFinish"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:importantForAutofill="no"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:textColor="@color/white"
                            android:id="@+id/saveBytes"
                            android:background="@color/colorPrimary"
                            android:padding="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btnLanSave_desc"
                            android:contentDescription="@string/btnLanSave_desc"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@android:drawable/ic_menu_save"/>
                        <TextView
                            android:textColor="@color/colorAccent"
                            android:id="@+id/btnHelpBytes"
                            android:padding="8dp"
                            android:focusable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:text="@string/meny_sub_2"
                            android:layout_marginStart="24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/saveBytes"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
