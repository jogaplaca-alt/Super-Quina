<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_important"
            android:id="@+id/txtConnectTypeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical"
            android:text="@string/panel_transport_title"
            android:drawablePadding="8dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="@dimen/card_inner_horizontal"
            app:drawableStartCompat="@drawable/ic_bluetooth_black_24dp"
            app:drawableTint="@color/color_important"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTransportType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_margin_vertical"
            android:layout_marginBottom="@dimen/card_margin_vertical"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginEnd="@dimen/card_margin_horizontal">
            <RadioGroup
                android:id="@+id/radioTransportType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:layout_marginStart="@dimen/card_inner_horizontal"
                android:layout_marginEnd="@dimen/card_inner_horizontal">
                <RadioButton
                    android:id="@+id/radioTransportBT"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/bluetooth"/>
                <RadioButton
                    android:id="@+id/radioTransportLAN"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/wifi_or_enthernet"/>
                <RadioButton
                    android:id="@+id/radioTransportUSB"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/usb"/>
                <RadioButton
                    android:id="@+id/radioTransportAIDL"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/AIDL"/>
            </RadioGroup>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_important"
            android:id="@+id/txtConnectParamTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical"
            android:text="@string/panel_connect_param_title"
            android:drawablePadding="8dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="@dimen/card_inner_horizontal"
            app:drawableStartCompat="@drawable/ic_bluetooth_black_24dp"
            app:drawableTint="@color/color_important"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/paramCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_margin_vertical"
            android:layout_marginBottom="@dimen/card_margin_vertical"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginEnd="@dimen/card_margin_horizontal">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:layout_marginStart="@dimen/card_inner_horizontal"
                android:layout_marginEnd="@dimen/card_inner_horizontal">
                <RelativeLayout
                    android:id="@+id/PanelBT"
                    android:background="@drawable/bean_nav"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/card_inner_vertical"
                    android:layout_marginBottom="@dimen/card_inner_vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_go"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/reSelectTxt"
                        android:layout_marginEnd="@dimen/card_inner_horizontal"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:id="@+id/bt_cur_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/panel_bt_title"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/card_inner_horizontal"/>
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/txtMAC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:text="@string/panel_bt_mac_init"
                        android:layout_marginStart="@dimen/card_inner_horizontal"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/PanelUSB"
                    android:background="@drawable/bean_nav"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="@dimen/card_inner_vertical"
                    android:layout_marginBottom="@dimen/card_inner_vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_go"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/reSelectTxt"
                        android:layout_marginEnd="@dimen/card_inner_horizontal"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:id="@+id/txtUsbName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/panel_usb_title"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="80dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/txtPidVid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="80dp"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/PanelCOM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <TextView
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/serial_port_driver"
                        android:layout_marginStart="@dimen/card_inner_horizontal"/>
                    <Spinner
                        android:id="@+id/comDriverSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:minHeight="48dp"
                        android:spinnerMode="dialog"/>
                    <TextView
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/baud_rate"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="@dimen/card_inner_horizontal"/>
                    <Spinner
                        android:id="@+id/baudSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:minHeight="48dp"
                        android:spinnerMode="dialog"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/PanelLAN"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:baselineAligned="false">
                        <com.google.android.material.textfield.TextInputLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="@string/editLan_ip_hint"
                            android:layout_weight="3">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editLanHost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editLan_ip_init"
                                android:inputType="text"
                                android:importantForAutofill="no"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="@string/editPort_hint"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editLanPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/editPort_inital"
                                android:inputType="number"
                                android:importantForAutofill="no"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/radioGroupBtType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical"
            android:layout_marginStart="@dimen/card_inner_horizontal"
            android:layout_marginEnd="@dimen/card_inner_horizontal">
            <RadioButton
                android:id="@+id/radioBT_Classic"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/bluetooth"/>
            <RadioButton
                android:id="@+id/radioBT_BLE"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ble_bluetooth_low_energy"
                android:layout_marginStart="16dp"/>
        </RadioGroup>
        <TextView
            android:textStyle="bold"
            android:id="@+id/ble_notice"
            android:background="@color/yellow"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/if_the_printer_does_not_support_classic"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/radioGroupUsbType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical"
            android:layout_marginStart="@dimen/card_inner_horizontal"
            android:layout_marginEnd="@dimen/card_inner_horizontal">
            <RadioButton
                android:id="@+id/radioUsbLpt"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/usb"/>
            <RadioButton
                android:id="@+id/radioUsbCom"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/com_over_usb"
                android:layout_marginStart="16dp"/>
        </RadioGroup>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_important"
            android:id="@+id/titleDriver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical"
            android:text="@string/driver"
            android:drawablePadding="8dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="@dimen/card_inner_horizontal"
            app:drawableStartCompat="@drawable/ic_stat_print"
            app:drawableTint="@color/color_important"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_margin_vertical"
            android:layout_marginBottom="@dimen/card_margin_vertical"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginEnd="@dimen/card_margin_horizontal">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:layout_marginStart="@dimen/card_inner_horizontal"
                android:layout_marginEnd="@dimen/card_inner_horizontal">
                <Spinner
                    android:id="@+id/spinnerAidlDriver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"/>
                <Spinner
                    android:id="@+id/spinnerDriver"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="@dimen/activity_horizontal_margin"
                    android:layout_weight="1"
                    android:spinnerMode="dialog"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/btnTryConnect"
            android:background="@drawable/bean_btn_blue"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_margin_horizontal"
            android:layout_marginRight="@dimen/card_margin_horizontal"
            android:layout_marginBottom="32dp"
            android:text="@string/connect"
            android:layout_marginHorizontal="@dimen/card_margin_horizontal"/>
        <ProgressBar
            android:id="@+id/progress_working"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/helloPrint"
            android:background="@drawable/bean_btn_blue"
            android:padding="8dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btnTest"
            android:drawablePadding="8dp"
            android:layout_marginStart="8dp"
            app:drawableStartCompat="@drawable/ic_local_printshop_blue_18dp"
            app:drawableTint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardName"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_margin_vertical"
            android:layout_marginBottom="@dimen/card_margin_vertical"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginEnd="@dimen/card_margin_horizontal">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/activity_horizontal_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPrinterName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/description">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPrinterDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/addPrinter"
            android:background="@drawable/bean_btn_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_margin_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginRight="@dimen/card_margin_horizontal"
            android:layout_marginBottom="32dp"
            android:text="@string/add_printer"
            android:layout_marginHorizontal="@dimen/card_margin_horizontal"/>
    </LinearLayout>
</ScrollView>
