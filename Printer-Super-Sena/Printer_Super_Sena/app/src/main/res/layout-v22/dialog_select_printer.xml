<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="130dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:id="@+id/progressPercent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:maxHeight="4dp"
        android:progressTint="@color/colorAccent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:gravity="center"
        android:id="@+id/txtStat"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textColor="@color/red"
        android:id="@+id/txtError"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textColor="@color/text_color"
        android:id="@+id/txtProgress"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preparing_a_print_job"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/printerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/printer"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <Spinner
        android:id="@+id/spinnerSelectPrinter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="8dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnCancel"
            android:background="@drawable/bean_btn_blue_dark"
            android:focusable="true"
            android:nextFocusUp="@+id/spinnerBarcodeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_cancel"
            android:layout_weight="1"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
        <Button
            android:enabled="false"
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnPrint"
            android:background="@drawable/bean_btn_blue"
            android:focusable="true"
            android:nextFocusUp="@+id/spinnerBarcodeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTxtPrint"
            android:layout_weight="1"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>
</LinearLayout>
