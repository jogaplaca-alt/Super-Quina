<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeLic"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:id="@+id/textLicStatus"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="center"/>
            <TextView
                android:id="@+id/textLicEnd"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="center"/>
            <ListView
                android:id="@+id/purchases_list"
                android:paddingBottom="0dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:divider="@color/activity_background"
                android:dividerHeight="0dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/skuList"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/buy1"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/_1_month"
                        android:layout_weight="1"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:id="@+id/sku_1_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textColor="@color/white"
                        android:background="@color/colorPrimaryDark"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        app:drawableStartCompat="@drawable/ic_shop_white_24dp"
                        app:drawableTint="@color/white"/>
                </LinearLayout>
                <View
                    android:background="@color/border_color"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <LinearLayout
                    android:id="@+id/buy3"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/_3_months"
                        android:layout_weight="1"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:id="@+id/sku_3_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textColor="@color/white"
                        android:background="@color/colorPrimaryDark"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        app:drawableStartCompat="@drawable/ic_shop_white_24dp"
                        app:drawableTint="@color/white"/>
                </LinearLayout>
                <View
                    android:background="@color/border_color"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <LinearLayout
                    android:id="@+id/buy12"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/_1_year"
                        android:layout_weight="1"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:id="@+id/sku_12_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textColor="@color/white"
                        android:background="@color/colorPrimary"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        app:drawableStartCompat="@drawable/ic_shop_white_24dp"
                        app:drawableTint="@color/white"/>
                </LinearLayout>
                <View
                    android:background="@color/border_color"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <LinearLayout
                    android:id="@+id/buy_lifetime"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/forever"
                        android:layout_weight="1"
                        android:textAlignment="viewStart"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:id="@+id/sku_lifetime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="viewEnd"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:textColor="@color/white"
                        android:background="@color/colorPrimaryDark"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        app:drawableStartCompat="@drawable/ic_shop_white_24dp"
                        app:drawableTint="@color/white"/>
                </LinearLayout>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnRefresh"
                    android:background="@color/colorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/check_license_status"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/text_margin"
                android:text="@string/faq_lic_anons"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Button"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:gravity="center"
                android:id="@+id/faq_license"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/link_my_faq_lic"/>
            <TextView
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/text_margin"
                android:text="@string/please_buy"/>
            <Button
                android:id="@+id/free_license"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stay_on_free"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/textAppVersion"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="64dp"
                android:text="@string/app_version"/>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
