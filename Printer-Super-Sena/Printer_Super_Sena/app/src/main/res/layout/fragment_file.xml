<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_file_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/intro"
        android:background="@color/activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ln2">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="64dp"
            android:paddingBottom="64dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imageView"
                android:focusable="false"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_marginTop="64dp"
                android:src="@mipmap/document"
                android:adjustViewBounds="false"
                android:contentDescription="@string/desc_prglogo"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:id="@+id/textViewFileName"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="8dp"
                android:text="@string/filename"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView"/>
            <TextView
                android:id="@+id/textViewFileSize"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:text="@string/not_selected"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewFileName"/>
            <TextView
                android:padding="16dp"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/help_txt"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewFileSize"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <ScrollView
        android:id="@+id/tab_text"
        android:background="@color/screen_white"
        android:paddingBottom="48dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/color_important"
            android:id="@+id/view_txt"
            android:paddingTop="80dp"
            android:paddingBottom="80dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </ScrollView>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/ln2"
        android:background="@color/gray_very_light"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RadioButton
            android:id="@+id/radioUseUtf"
            android:nextFocusDown="@+id/btnSelectTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_utf_8"
            android:nextFocusForward="@+id/tab_text"/>
        <RadioButton
            android:id="@+id/radioLocalCP"
            android:nextFocusDown="@+id/btnSelectTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusForward="@+id/tab_text"/>
    </RadioGroup>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/bottom_sheet"
        android:background="@color/darker_gray"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="50dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottomBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <Button
                android:textColor="@color/color_on_dark_btn_text"
                android:id="@+id/btnSelectTxt"
                android:background="@drawable/bean_btn_blue_dark"
                android:focusable="true"
                android:nextFocusUp="@+id/view_txt"
                android:nextFocusDown="@+id/rbAlignLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reSelectTxt"
                android:layout_weight="1"
                style="@style/Widget.AppCompat.Button.Colored"/>
            <Button
                android:textColor="@color/color_on_dark_btn_text"
                android:id="@+id/btnTxtPrint"
                android:background="@drawable/bean_btn_blue"
                android:focusable="true"
                android:visibility="gone"
                android:nextFocusUp="@+id/view_txt"
                android:nextFocusDown="@+id/rbAlignLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnTxtPrint"
                android:layout_weight="1"
                style="@style/Widget.AppCompat.Button.Colored"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/imageViewBottomSwipe"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/open_txt"
            app:layout_constraintBottom_toBottomOf="@+id/bottomBtn"
            app:srcCompat="@drawable/up"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            app:layout_constraintTop_toBottomOf="@+id/imageViewBottomSwipe">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/card_inner_vertical">
                <RadioGroup
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <RadioButton
                        android:id="@+id/rbAlignLeft"
                        android:tag="binding_1"
                        android:focusable="true"
                        android:nextFocusUp="@+id/btnSelectTxt"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_align_left_24"/>
                    <RadioButton
                        android:id="@+id/rbAlignCenter"
                        android:tag="binding_2"
                        android:focusable="true"
                        android:nextFocusUp="@+id/btnSelectTxt"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_align_center_24"/>
                    <RadioButton
                        android:id="@+id/rbAlignRight"
                        android:tag="binding_3"
                        android:focusable="true"
                        android:nextFocusUp="@+id/btnSelectTxt"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_align_right_24"/>
                </RadioGroup>
                <Spinner
                    android:layout_gravity="end"
                    android:id="@+id/spinnerFontType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:textAlignment="textEnd"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp">
                <CheckBox
                    android:textColor="@color/screen_white"
                    android:tag="binding_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wx2"/>
                <CheckBox
                    android:textColor="@color/screen_white"
                    android:tag="binding_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hx2"/>
                <CheckBox
                    android:tag="binding_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_bold_24"/>
                <CheckBox
                    android:tag="binding_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_underlined_24"/>
            </LinearLayout>
            <TextView
                android:id="@+id/textGraphFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <SeekBar
                android:id="@+id/seekBarFont"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_marginBottom="24dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/background_color"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/printer"
                    android:layout_marginEnd="16dp"/>
                <Spinner
                    android:id="@+id/spinnerSelectPrinter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/background_color"
                android:paddingBottom="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:gravity="start"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/template"/>
                    <Spinner
                        android:id="@+id/spinnerSelectTemplate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/copies"/>
                    <Spinner
                        android:id="@+id/spinnerNumbersCopies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:id="@+id/task_progress_bar"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="64dp"
        android:maxHeight="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
