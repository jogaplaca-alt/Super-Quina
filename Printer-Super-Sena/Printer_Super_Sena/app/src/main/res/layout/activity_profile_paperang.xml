<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:background="@color/activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/darkness"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/ic_blur_on_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <RadioGroup
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="@dimen/card_inner_vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="@dimen/card_inner_horizontal">
                    <RadioButton
                        android:id="@+id/dark0"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/light"
                        android:layout_marginEnd="8dp"/>
                    <RadioButton
                        android:id="@+id/dark1"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/normal"
                        android:layout_marginEnd="8dp"/>
                    <RadioButton
                        android:id="@+id/dark2"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dark"/>
                </RadioGroup>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/flow_control"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/ic_settings_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_inner_vertical"
                    android:layout_marginBottom="@dimen/card_inner_vertical"
                    android:baselineAligned="false"
                    android:layout_marginStart="@dimen/card_inner_vertical"
                    android:layout_marginEnd="@dimen/card_inner_horizontal">
                    <TextView
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:paddingBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/wait_before_disconnect"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="0dp"/>
                    <TextView
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/use_it_if_printer_don_t"
                        android:layout_marginStart="0dp"/>
                    <Spinner
                        android:id="@+id/delayBeforeDisconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:spinnerMode="dialog"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="@dimen/card_inner_horizontal"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/information"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/info"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_inner_vertical"
                    android:layout_marginBottom="@dimen/card_inner_vertical"
                    android:baselineAligned="false"
                    android:layout_marginStart="@dimen/card_inner_vertical"
                    android:layout_marginEnd="@dimen/card_inner_horizontal">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_model"
                            android:layout_weight="1"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/info_paperang_model"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_d"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_model_version"
                            android:layout_weight="1"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/info_paperang_ver"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_d"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_serial_number"
                            android:layout_weight="1"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/info_paperang_sn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_d"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/color_important"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/info_battery"
                            android:layout_weight="1"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/info_paperang_bat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_d"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <ProgressBar
                android:id="@+id/progress_Paperang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_horizontal_margin"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/selfTestPrint"
                android:background="@drawable/bean_btn_blue"
                android:padding="8dp"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="64dp"
                android:text="@string/print_self_test_page"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                app:drawableStartCompat="@drawable/ic_local_printshop_blue_18dp"
                app:drawableTint="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/select_printer_model"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/ic_stat_print"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="@dimen/card_inner_vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="@dimen/card_inner_horizontal">
                    <Button
                        android:id="@+id/radioModelP1"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="P1"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/radioModelP2"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="P2"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/radioModelP3"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="P3"
                        android:layout_weight="1"/>
                    <Button
                        android:id="@+id/radioModelC1"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="C1"
                        android:layout_weight="1"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
