            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:text="@string/faq_con_usb_permission_grant"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/usb_rawbt"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/card_inner_horizontal"
            android:layout_marginEnd="@dimen/card_inner_horizontal"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:text="@string/faq_con_usb_permission_grant_2"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/text_margin"
            android:text="@string/wifi_or_enthernet"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_wifi_black_24dp"
            app:drawableTint="@color/color_important"/>
