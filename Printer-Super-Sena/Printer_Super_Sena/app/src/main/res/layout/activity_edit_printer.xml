<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/white"
                    android:id="@+id/txtConnectParam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Large"
                    android:textColor="@color/white"
                    android:id="@+id/txtPrinterDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtConnectParam"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/white"
                    android:id="@+id/txtPrinterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtPrinterDescription"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:textColor="@color/white"
                    android:id="@+id/switchUseAsDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:checked="false"
                    android:minHeight="48dp"
                    android:text="@string/set_as_default"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtPrinterName"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:id="@+id/txtDriverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/driver"
                android:drawablePadding="8dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/ic_stat_print"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <TextView
                    android:textSize="18sp"
                    android:id="@+id/txtDriver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:id="@+id/textDpi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/dpi"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/ic_blur_on_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@+id/radioGroupDpi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="@dimen/card_inner_vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="@dimen/card_inner_horizontal">
                        <RadioButton
                            android:id="@+id/radioDpi203"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/_203dpi"/>
                        <RadioButton
                            android:id="@+id/radioDpi304"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/_304dpi"/>
                    </RadioGroup>
                    <TextView
                        android:textSize="18sp"
                        android:id="@+id/txtDpi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:id="@+id/txtWidth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/width"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/ic_width"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_inner_horizontal"
                    android:layout_marginBottom="@dimen/card_inner_vertical"
                    android:layout_marginStart="@dimen/card_inner_horizontal"
                    android:layout_marginEnd="@dimen/card_inner_horizontal">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/card_inner_vertical">
                        <ImageView
                            android:id="@+id/ruler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scaleType="fitStart"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/ruler"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputLayout
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_inner_vertical"
                            android:layout_marginBottom="0dp"
                            android:hint="@string/print_area_dots"
                            android:layout_weight="4"
                            android:layout_marginStart="@dimen/card_inner_horizontal"
                            android:layout_marginEnd="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editPixelsWidth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:inputType="number"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <ImageButton
                            android:id="@+id/btnCalcWidth"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginRight="16dp"
                            app:srcCompat="@drawable/calculate_24"
                            app:tint="@color/white"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/input_dots_count_comment"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/colorAccent"
                            android:id="@+id/helpMoreWidth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/meny_sub_2"
                            android:layout_marginStart="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textColor="@color/white"
                            android:id="@+id/saveGraphics"
                            android:background="@color/colorPrimary"
                            android:padding="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btnLanSave_desc"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/btnPrintRuler"
                android:background="@color/colorPrimary"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_horizontal_margin"
                android:text="@string/btnTest"
                android:drawablePadding="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:drawableStartCompat="@drawable/ic_local_printshop_white_18dp"
                app:drawableTint="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:id="@+id/txtInternalization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:text="@string/panel_local_title"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                app:drawableStartCompat="@drawable/ic_language_black_24dp"
                app:drawableTint="@color/color_important"/>
            <Spinner
                android:id="@+id/spinnerLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:spinnerMode="dialog"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardTestPrint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/textDemoPrintSimple"
                    android:background="@color/colorPrimary"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/short_text"
                    android:drawablePadding="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:drawableStartCompat="@drawable/ic_local_printshop_white_18dp"
                    app:drawableTint="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/textDemoPrint"
                    android:background="@color/colorPrimary"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/long_test"
                    android:drawablePadding="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="@dimen/card_inner_horizontal"
                    app:drawableStartCompat="@drawable/ic_local_printshop_white_18dp"
                    app:drawableTint="@color/white"
                    app:layout_constraintStart_toEndOf="@+id/textDemoPrintSimple"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/txtUseMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="@string/use_more_settings"/>
            <Button
                android:id="@+id/gotoPrinterConfigure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/activity_horizontal_margin"
                android:text="@string/more_settings"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/Widget.AppCompat.Button"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardForVirtual"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_inner_vertical"
                    android:layout_marginBottom="@dimen/card_inner_vertical"
                    android:layout_marginStart="@dimen/card_inner_horizontal"
                    android:layout_marginEnd="@dimen/card_inner_horizontal">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_inner_vertical"
                        android:layout_marginBottom="@dimen/card_inner_vertical"
                        android:text="@string/preview_frame"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="@dimen/card_inner_horizontal"
                        app:drawableStartCompat="@drawable/ic_settings_black_24dp"
                        app:drawableTint="@color/color_important"/>
                    <CheckBox
                        android:textSize="16sp"
                        android:id="@+id/chkPreviewFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/add_frame_around_print_area"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/textForVirtual"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_horizontal_margin"
                android:text="@string/git_virtual_prn"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <TextView
                    android:textColor="@color/colorAccent"
                    android:id="@+id/btnDebug"
                    android:padding="8dp"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/btn_open_terminal_caption"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/print_progress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
