<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.gridlayout.widget.GridLayout
        android:layout_gravity="center"
        android:id="@+id/grid_view"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:columnCount="@integer/grid_columns"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:orientation="horizontal"
        app:useDefaultMargins="true">
        <ImageButton
            android:id="@+id/btn_main_home"
            android:background="@drawable/border_1_kbd"
            android:padding="28dp"
            android:focusable="true"
            android:contentDescription="@string/mitem_home"
            app:srcCompat="@drawable/baseline_home_48"
            app:tint="@color/color_icon"/>
        <ImageButton
            android:id="@+id/btn_main_edit"
            android:background="@drawable/border_1_kbd"
            android:padding="28dp"
            android:focusable="true"
            android:src="@drawable/baseline_mode_edit_black_48"
            android:contentDescription="@string/mitem_editor"
            app:tint="@color/color_icon"/>
        <ImageButton
            android:id="@+id/btn_main_txt"
            android:background="@drawable/border_1_kbd"
            android:padding="28dp"
            android:focusable="true"
            android:contentDescription="@string/mitem_txtfile"
            app:srcCompat="@drawable/baseline_sd_card_48"
            app:tint="@color/color_icon"/>
        <ImageButton
            android:id="@+id/btn_main_pdf"
            android:background="@drawable/border_1_kbd"
            android:padding="28dp"
            android:focusable="true"
            android:src="@drawable/baseline_picture_as_pdf_black_48"
            android:contentDescription="@string/mitem_pdffile"
            app:tint="@color/color_icon"/>
        <ImageButton
            android:id="@+id/btn_main_img"
            android:background="@drawable/border_1_kbd"
            android:padding="28dp"
            android:focusable="true"
            android:src="@drawable/baseline_insert_photo_black_48"
            android:contentDescription="@string/mitem_imgfile"
            app:tint="@color/color_icon"/>
        <ImageButton
            android:id="@+id/btn_main_setting"
            android:background="@drawable/border_1_kbd"
            android:padding="28dp"
            android:focusable="true"
            android:src="@drawable/baseline_settings_applications_black_48"
            android:contentDescription="@string/mitem_settings"
            app:tint="@color/color_icon"/>
    </androidx.gridlayout.widget.GridLayout>
    <TextView
        android:id="@+id/text_free1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="******************************"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/grid_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/color_important"
        android:id="@+id/text_free2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/free_notice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_free1"/>
    <TextView
        android:id="@+id/text_free3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="******************************"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_free2"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorAccent"
        android:id="@+id/text_free_click"
        android:background="@drawable/bean_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/faq_lic_how_remove"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_free3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
