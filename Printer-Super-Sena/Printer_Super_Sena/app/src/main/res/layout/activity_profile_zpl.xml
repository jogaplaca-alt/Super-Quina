<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:background="@color/activity_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:text="@string/cut_command"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                app:drawableStartCompat="@drawable/ic_baseline_content_cut_24"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:text="@string/skip_lines"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <Spinner
                        android:id="@+id/spinnerLines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:spinnerMode="dialog"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:text="@string/cut_command"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <Spinner
                        android:id="@+id/spinnerCut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:layout_marginBottom="@dimen/card_margin_vertical"
                        android:spinnerMode="dialog"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:text="@string/flow_control"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_inner_horizontal"
                app:drawableStartCompat="@drawable/ic_settings_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_inner_vertical"
                    android:layout_marginBottom="@dimen/card_inner_vertical"
                    android:baselineAligned="false"
                    android:layout_marginStart="@dimen/card_inner_vertical"
                    android:layout_marginEnd="@dimen/card_inner_horizontal">
                    <TextView
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/buffer_protect_delay_ms"
                        android:layout_marginStart="0dp"/>
                    <Spinner
                        android:id="@+id/lanDelaySpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:spinnerMode="dialog"/>
                    <TextView
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:paddingBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/wait_before_disconnect"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="0dp"/>
                    <TextView
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:text="@string/use_it_if_printer_don_t"
                        android:layout_marginStart="0dp"/>
                    <Spinner
                        android:id="@+id/delayBeforeDisconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="16dp"
                        android:spinnerMode="dialog"
                        android:layout_marginStart="@dimen/card_inner_horizontal"
                        android:layout_marginEnd="@dimen/card_inner_horizontal"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="@dimen/card_margin_vertical"
                android:text="@string/for_expert"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                app:drawableStartCompat="@drawable/ic_settings_black_24dp"
                app:drawableTint="@color/color_important"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_margin_vertical"
                android:layout_marginBottom="32dp"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_margin_vertical"
                    android:layout_marginBottom="@dimen/card_margin_vertical"
                    android:layout_marginStart="@dimen/card_margin_horizontal"
                    android:layout_marginEnd="@dimen/card_margin_horizontal">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_important"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_margin_vertical"
                        android:text="@string/to_input_emulation_mode_selection_commands"
                        android:drawablePadding="8dp"
                        android:layout_marginStart="@dimen/card_margin_horizontal"
                        android:layout_marginEnd="@dimen/card_margin_horizontal"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/start_bytes"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editBytesInit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/finish_bytes"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editBytesFinish"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:textColor="@color/white"
                            android:id="@+id/saveBytes"
                            android:background="@color/colorPrimary"
                            android:padding="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btnLanSave_desc"
                            android:contentDescription="@string/btnLanSave_desc"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@android:drawable/ic_menu_save"/>
                        <TextView
                            android:textColor="@color/colorAccent"
                            android:id="@+id/btnHelpBytes"
                            android:padding="8dp"
                            android:focusable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:text="@string/meny_sub_2"
                            android:layout_marginStart="24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/saveBytes"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
