<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet"
    android:background="@color/darker_gray"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    app:behavior_hideable="false"
    app:behavior_peekHeight="64dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent">
        <EditText
            android:id="@+id/send_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/bytes"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"/>
        <ImageButton
            android:id="@+id/send_btn"
            android:background="@drawable/bean_btn_blue"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:contentDescription="@string/send"
            app:srcCompat="@drawable/ic_send_white_24dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/escButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/bottomInput">
        <Button
            android:id="@+id/btnESC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESC"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <Button
            android:id="@+id/btnFS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FS"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <Button
            android:id="@+id/btnGS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GS"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <Button
            android:id="@+id/btnSOH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOH"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <Button
            android:id="@+id/btnSTX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STX"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <Button
            android:id="@+id/btnSemicolon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=";"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <Button
            android:id="@+id/btnCR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CR"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/asciiButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/bottomInput">
        <Button
            android:id="@+id/btnCaret"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="^"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <Button
            android:id="@+id/btnTilda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="~"
            android:layout_weight="1"
            style="@style/TextAppearance.AppCompat.Widget.Button"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5">
            <Spinner
                android:id="@+id/encodeSpinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:spinnerMode="dialog"
                android:layout_marginStart="@dimen/card_inner_horizontal"
                android:layout_marginEnd="@dimen/card_inner_horizontal"/>
            <Spinner
                android:id="@+id/lfSpinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:spinnerMode="dialog"
                android:layout_marginStart="@dimen/card_inner_horizontal"
                android:layout_marginEnd="@dimen/card_inner_horizontal"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textStyle="bold"
        android:id="@+id/txtHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="@string/history"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        app:layout_constraintTop_toBottomOf="@+id/bottomInput"/>
    <ru.a402d.rawbtprinter.utils.BottomSheetListView
        android:id="@+id/history_list"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtHistory"/>
    <View
        android:background="@color/activity_background"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomInput"/>
    <View
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomInput"/>
    <ImageView
        android:id="@+id/imageViewBottomSwipe"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/navigation_drawer_open"
        app:layout_constraintBottom_toTopOf="@+id/bottomInput"
        app:srcCompat="@drawable/up"/>
</androidx.constraintlayout.widget.ConstraintLayout>
