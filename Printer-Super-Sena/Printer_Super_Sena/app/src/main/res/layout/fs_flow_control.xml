<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_inner_horizontal"
    android:layout_marginBottom="@dimen/card_inner_vertical"
    android:layout_marginStart="@dimen/card_inner_horizontal"
    android:layout_marginEnd="@dimen/card_inner_horizontal">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/color_important"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_inner_vertical"
        android:layout_marginBottom="@dimen/card_inner_vertical"
        android:text="@string/flow_control"
        android:drawablePadding="8dp"
        android:layout_marginStart="@dimen/card_inner_horizontal"
        android:layout_marginEnd="@dimen/card_inner_horizontal"
        app:drawableStartCompat="@drawable/ic_settings_black_24dp"
        app:drawableTint="@color/color_important"/>
    <androidx.cardview.widget.CardView
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_margin_vertical"
        android:layout_marginBottom="@dimen/card_margin_vertical"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginEnd="@dimen/card_margin_horizontal">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical"
            android:baselineAligned="false"
            android:layout_marginStart="@dimen/card_inner_vertical"
            android:layout_marginEnd="@dimen/card_inner_horizontal">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/chkAllowGSr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:checkMark="?android:attr/listChoiceIndicatorMultiple"
                android:text="@string/send_a_command_transmission_of_status"
                android:layout_marginStart="@dimen/card_inner_horizontal"
                android:layout_marginEnd="@dimen/card_inner_horizontal"/>
            <TextView
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/buffer_protect_delay_ms"
                android:layout_marginStart="0dp"/>
            <Spinner
                android:id="@+id/lanDelaySpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:spinnerMode="dialog"/>
            <TextView
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/wait_before_disconnect"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="0dp"/>
            <TextView
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/use_it_if_printer_don_t"
                android:layout_marginStart="0dp"/>
            <Spinner
                android:id="@+id/delayBeforeDisconect"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="16dp"
                android:spinnerMode="dialog"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:id="@+id/youtubeFlowControl"
                android:background="@drawable/bean_nav"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_to_fix_printing_errors"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                app:drawableStartCompat="@drawable/ic_youtube"
                app:drawableTint="@color/colorAccent"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
