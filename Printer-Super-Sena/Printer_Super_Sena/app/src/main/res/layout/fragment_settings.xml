<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp">
        <androidx.appcompat.widget.SwitchCompat
            android:textStyle="bold"
            android:id="@+id/turnOn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:checkMark="?android:attr/listChoiceIndicatorMultiple"
            android:textOn="@string/on"
            android:textOff="@string/off"
            android:text="@string/run_as_a_print_service"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_important"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/your_printers"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_stat_print"
            app:drawableTint="@color/color_important"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPrinters"
            android:background="@color/activity_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_margin_horizontal"
            android:layout_marginRight="@dimen/card_margin_horizontal"
            android:overScrollMode="never"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btnAddPrinter"
            android:background="@drawable/bean_btn_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/card_margin_horizontal"
            android:text="@string/add_printer"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_margin_vertical"
            android:layout_marginBottom="@dimen/card_margin_vertical"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginEnd="@dimen/card_margin_horizontal">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_inner_vertical"
                android:layout_marginBottom="@dimen/card_inner_vertical"
                android:layout_marginStart="@dimen/card_inner_horizontal"
                android:layout_marginEnd="@dimen/card_inner_horizontal">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/color_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/for_share_and_send"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <CheckBox
                    android:id="@+id/chkStartPrint"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="@string/start_printing_automatically_on_the_default_printer"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/word_or"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <CheckBox
                    android:id="@+id/chkPreviewMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/txtUsePreview"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <RelativeLayout
            android:id="@+id/goPermissions"
            android:background="@drawable/bean_nav"
            android:paddingBottom="16dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_go"
                android:layout_centerVertical="true"
                android:contentDescription="@string/reSelectTxt"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:tint="@color/text_color"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="32dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/required_permissions"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/alert_black_24"
                    app:drawableTint="@color/color_important"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/goExtSettings"
            android:background="@drawable/bean_nav"
            android:paddingBottom="16dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_go"
                android:layout_centerVertical="true"
                android:contentDescription="@string/settings_ext"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:tint="@color/text_color"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="32dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_ext"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/ic_settings_black_24dp"
                    app:drawableTint="@color/color_important"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/goTemplate"
            android:background="@drawable/bean_nav"
            android:paddingBottom="16dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_go"
                android:layout_centerVertical="true"
                android:contentDescription="@string/document_template"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:tint="@color/text_color"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="32dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/document_template"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/ic_baseline_receipt_long_24"
                    app:drawableTint="@color/color_important"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/otherServices"
            android:background="@drawable/bean_nav"
            android:paddingBottom="16dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_go"
                android:layout_centerVertical="true"
                android:contentDescription="@string/configure_other_services"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:tint="@color/text_color"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="32dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_important"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/configure_other_services"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/baseline_miscellaneous_services_24"
                    app:drawableTint="@color/color_important"/>
                <TextView
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/share_your_printer_with_others"
                    android:layout_marginStart="32dp"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
