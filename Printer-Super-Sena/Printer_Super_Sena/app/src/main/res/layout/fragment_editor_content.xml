<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollBlock"
    android:background="@color/background_color"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="50dp">
    <com.google.android.material.textfield.TextInputLayout
        android:background="@color/background_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/input_editor">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="18sp"
            android:gravity="top"
            android:id="@+id/input_area"
            android:nextFocusLeft="@+id/btnEditSelect"
            android:nextFocusRight="@+id/btnEditPrint"
            android:nextFocusDown="@+id/btnEditSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="12"
            android:inputType="textMultiLine"
            android:nextFocusForward="@+id/btnEditSelect"/>
    </com.google.android.material.textfield.TextInputLayout>
</ScrollView>
