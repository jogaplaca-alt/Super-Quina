<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet"
    android:background="@color/darker_gray"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    app:behavior_hideable="false"
    app:behavior_peekHeight="48dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnPdfSelect"
            android:background="@drawable/bean_btn_blue_dark"
            android:focusable="true"
            android:nextFocusUp="@+id/pager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reSelectTxt"
            android:layout_weight="1"
            style="@style/Widget.AppCompat.Button.Colored"/>
        <Button
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnPdfPrint"
            android:background="@drawable/bean_btn_blue"
            android:focusable="true"
            android:nextFocusUp="@+id/pager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTxtPrint"
            android:layout_weight="1"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/imageViewBottomSwipe"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/navigation_drawer_open"
        app:layout_constraintBottom_toBottomOf="@+id/bottomBtn"
        app:srcCompat="@drawable/up"/>
    <TextView
        android:id="@+id/textCurrentPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@+id/bottomBtn"/>
    <SeekBar
        android:id="@+id/seekBar"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textCurrentPosition"
        style="@style/Widget.AppCompat.SeekBar.Discrete"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:layout_constraintTop_toBottomOf="@+id/seekBar">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_important"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_action_selection"
            android:drawablePadding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:drawableStartCompat="@drawable/ic_settings_black_24dp"
            app:drawableTint="@color/color_important"/>
        <Spinner
            android:id="@+id/pdfBtnActionSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/panelPrint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_important"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/truncation_rules"
                android:drawablePadding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:drawableStartCompat="@drawable/ic_picture_as_pdf_black_24dp"
                app:drawableTint="@color/color_important"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <Spinner
                        android:id="@+id/spinnerWidthTruncate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_inner_vertical"
                        android:layout_marginBottom="@dimen/card_inner_vertical"
                        android:spinnerMode="dialog"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <CheckBox
                        android:textSize="16sp"
                        android:id="@+id/chkRoll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/roll"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/background_color"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/printer"
                    android:layout_marginEnd="16dp"/>
                <Spinner
                    android:id="@+id/spinnerSelectPrinter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/background_color"
                android:paddingBottom="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:gravity="start"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/template"/>
                    <Spinner
                        android:id="@+id/spinnerSelectTemplate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/copies"/>
                    <Spinner
                        android:id="@+id/spinnerNumbersCopies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
