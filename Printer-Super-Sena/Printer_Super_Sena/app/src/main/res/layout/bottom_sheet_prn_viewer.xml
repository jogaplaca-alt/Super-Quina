<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_sheet"
    android:background="@color/darker_gray"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    app:behavior_hideable="false"
    app:behavior_peekHeight="48dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnPrnSelect"
            android:background="@drawable/bean_btn_blue_dark"
            android:focusable="true"
            android:nextFocusUp="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reSelectTxt"
            android:layout_weight="1"
            style="@style/Widget.AppCompat.Button.Colored"/>
        <Button
            android:textColor="@color/color_on_dark_btn_text"
            android:id="@+id/btnPrnPrint"
            android:background="@drawable/bean_btn_blue"
            android:focusable="true"
            android:nextFocusUp="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTxtPrint"
            android:layout_weight="1"
            style="@style/Widget.AppCompat.Button.Colored"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/imageViewBottomSwipe"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/navigation_drawer_open"
        app:layout_constraintBottom_toBottomOf="@+id/bottomBtn"
        app:srcCompat="@drawable/up"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/imageViewBottomSwipe">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_important"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_action_selection"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_settings_black_24dp"
            app:drawableTint="@color/color_important"/>
        <RadioGroup
            android:id="@+id/btnPrnActionSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_inner_vertical"
            android:layout_marginBottom="@dimen/card_inner_vertical">
            <RadioButton
                android:id="@+id/prnBtnActionPrintPrn"
                android:focusable="true"
                android:nextFocusUp="@+id/btnPrnPrint"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/print_prn"/>
            <RadioButton
                android:id="@+id/prnBtnActionPrintImage"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/print_preview_image"/>
        </RadioGroup>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
